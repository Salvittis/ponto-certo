{
    admin off
    http_port 8080
    https_port 8443
    persist_config off
}

{$PUBLIC_HOST} {
    # Access logs are deliberately disabled: no questions, IPs or query strings.
    request_body {
        max_size 16KB
    }
    header {
        Strict-Transport-Security "max-age=86400"
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        -Server
    }
    reverse_proxy app:8000
}
