# syntax=docker/dockerfile:1
FROM --platform=$BUILDPLATFORM golang:1.27.4-alpine@sha256:70bd7ddea8b6cbe5d6943cde279d6b67feb10cc924fb9100d1d8757c1575b280 AS build
WORKDIR /src
ENV CGO_ENABLED=0 GOTOOLCHAIN=local GOMAXPROCS=2
COPY proxy/go.mod proxy/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download && go mod verify
COPY proxy/main.go ./
ARG TARGETARCH
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    GOOS=linux GOARCH=$TARGETARCH go build -mod=readonly -p 2 -trimpath -ldflags='-s -w' -o /out/caddy .

# The upstream OS/certificates/layout are retained; the vulnerable binary is replaced.
FROM caddy:2.11.9-alpine@sha256:003a97808e781aa9f7e75cc2f43d34d461099031faf5e20faefb9f61126836f0
ARG APP_REVISION=development
LABEL org.opencontainers.image.source="https://github.com/Salvittis/ponto-certo" \
      org.opencontainers.image.title="Ponto Certo HTTPS proxy" \
      org.opencontainers.image.revision=$APP_REVISION
COPY --from=build /out/caddy /usr/bin/caddy
USER 10001:10001
EXPOSE 8080 8443
